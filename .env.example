APP_ENV=development
PORT=3000
SQLITE_PATH=data/gemhunter.db
LITESTREAM_ENABLED=false
REDIS_URL=redis://redis:6379/0
SECTORS_API_KEY=
SECTORS_BASE_URL=https://api.sectors.app
# ON/OFF for Sectors API above: true = use SECTORS_API_KEY (costs credits) | false = ignore key, use mock (free, 0 credits)
LIVE_SECTORS_ENABLED=true
RANKING_INTERVAL_HOURS=6
MIN_EPS_GROWTH=0
MAX_DATA_AGE_HOURS=168
MIN_MARKET_CAP=
MIN_AVG_VALUE_20D=
ADMIN_TOKEN=change-me
TZ=Asia/Jakarta

# --- Live Sectors universe tuning (only when LIVE_SECTORS_ENABLED=true) ---
# Credit policy: 1 credit/query screener, 1 credit/section report, ~4 credits/ticker.
# Default 20 tickers * 4 sections = 81 credits per refresh, TTL 168h (7 days) = ~11 refreshes in 2 months (~730 credits / 1000).
UNIVERSE_MIN_MARKET_CAP=50000000000000
UNIVERSE_MAX_TICKERS=20
SECTORS_CACHE_TTL_HOURS=168

# --- Agentic LLM (analisis) - minimal 5 populer + 1 OpenAPI compatible ---
# Populer:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
# OpenAI-compatible (Ollama / OpenRouter / vLLM / LM Studio / custom):
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
# ON/OFF for LLM API above: true = use LLM keys (costs tokens) | false = ignore keys, deterministic fallback (free, 0 cost)
LLM_ENABLED=true
# Contoh: Ollama lokal -> http://host.docker.internal:11434/v1
# Contoh: OpenRouter -> https://openrouter.ai/api/v1
LLM_DEFAULT_PROVIDER=openai
LLM_DEFAULT_MODEL=gpt-4o-mini

# --- Email Notifications (SMTP) ---
# Contoh Brevo (Gratis 300 email/hari):
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-login@email.com
# SMTP_PASSWORD=your-brevo-smtp-key
# SMTP_FROM=Gem Hunter <alerts@gemhunter.app>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Gem Hunter <alerts@gemhunter.app>
EMAIL_ALERTS_ENABLED=true
